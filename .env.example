# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ff14_db
POSTGRES_USER=ff14
POSTGRES_PASSWORD=ff14local

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_URL=amqp://ff14:ff14local@localhost:5672
RABBITMQ_USER=ff14
RABBITMQ_PASS=ff14local

# ── Firebase (api-gateway only) ───────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── API Keys ──────────────────────────────────────────────────────
API_KEY_SECRET=change-me-in-production

# ── Service Ports ─────────────────────────────────────────────────
API_GATEWAY_PORT=3000
PRICES_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
ORDERS_SERVICE_PORT=3003
RECIPES_SERVICE_PORT=3004

NODE_ENV=development

