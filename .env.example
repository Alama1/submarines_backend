# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ff14_db
POSTGRES_USER=ff14
POSTGRES_PASSWORD=ff14local

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_URL=amqp://ff14:ff14local@localhost:5672
RABBITMQ_USER=ff14
RABBITMQ_PASS=ff14local

# ── Firebase Admin SDK (api-gateway container in Portainer) ───────
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Firebase Web SDK (admin-panel container in Portainer) ─────────
# From Firebase Console → Project settings → General → Your apps → SDK snippet
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Admin access ──────────────────────────────────────────────────
ALLOWED_EMAILS=you@example.com
ADMIN_API_KEY=change-me-in-production

# ── API Keys ──────────────────────────────────────────────────────
API_KEY_SECRET=change-me-in-production

# ── Service Ports ─────────────────────────────────────────────────
# Host + container listen port for api-gateway. Admin-panel nginx proxies /api here.
# Change this when 3000 is already used on the host (e.g. 3010).
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=api-gateway
PRICES_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
ORDERS_SERVICE_PORT=3003
RECIPES_SERVICE_PORT=3004

NODE_ENV=development

