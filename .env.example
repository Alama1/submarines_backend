# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ff14_db
POSTGRES_USER=ff14
POSTGRES_PASSWORD=ff14local

# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_URL=amqp://ff14:ff14local@localhost:5672
RABBITMQ_USER=ff14
RABBITMQ_PASS=ff14local

# ── Internal service-to-service auth (gateway -> services, RMQ) ───
# Must be identical across all containers
INTERNAL_TOKEN=dev-internal-token

# ── Firebase Admin SDK (api-gateway container in Portainer) ───────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Firebase Web SDK (admin-panel container in Portainer) ─────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Admin access ──────────────────────────────────────────────────
ALLOWED_EMAILS=you@example.com
ADMIN_API_KEY=change-me-in-production

# ── CORS (api-gateway). Comma-separated origins; empty = reflect any origin ──
CORS_ORIGINS=

# ── Service Ports ─────────────────────────────────────────────────
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=api-gateway
PRICES_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
ORDERS_SERVICE_PORT=3003
RECIPES_SERVICE_PORT=3004

NODE_ENV=development
