# Copy into the Portainer stack's environment variables (or a .env file)
# IMPORTANT: use the SAME values as the old stack / app services.
# With an existing data volume, user/db/password only apply at first init —
# they are not changed by re-deploying. Match the old stack's values.
POSTGRES_DB=ff14_db
POSTGRES_USER=ff14
POSTGRES_PASSWORD=change-me
