{
  "name": "@ff14/entities",
  "version": "1.0.0",
  "private": false,
  "description": "Shared TypeORM entity classes for the FF14 submarines backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:show": "pnpm typeorm migration:show",
    "typeorm:gateway": "typeorm-ts-node-commonjs -d src/gateway-data-source.ts",
    "migration:gateway:generate": "pnpm typeorm:gateway migration:generate",
    "migration:gateway:run": "pnpm typeorm:gateway migration:run"
  },
  "peerDependencies": {
    "typeorm": ">=0.3.0",
    "reflect-metadata": ">=0.1.0"
  },
  "dependencies": {
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "typescript": "^5.0.0"
  }
}
